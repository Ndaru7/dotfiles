// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "restore_on_startup": "last_session",
  "agent": {
    "dock": "right",
    "button": false,
    "model_parameters": [],
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "notification_panel": {
    "dock": "right",
    "button": true,
  },
  "debugger": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
    "collapse_untracked_diff": false,
    "status_style": "icon",
    "button": true,
  },
  "outline_panel": {
    "folder_icons": true,
    "file_icons": true,
    "dock": "left",
    "button": true,
  },
  "active_pane_modifiers": {
    "border_size": 0.0,
    "inactive_opacity": 0.8,
  },
  "use_system_window_tabs": true,
  "zoomed_padding": true,
  "window_decorations": "client",
  "bottom_dock_layout": "contained",
  "preview_tabs": {
    "enabled": true,
  },
  "tabs": {
    "close_position": "right",
    "file_icons": false,
    "git_status": true,
  },
  "tab_bar": {
    "show_tab_bar_buttons": true,
    "show_nav_history_buttons": false,
    "show": true,
  },
  "title_bar": {
    "show_sign_in": true,
    "show_user_picture": true,
    "show_onboarding_banner": true,
    "show_branch_name": true,
    "show_project_items": false,
    "show_menus": false,
    "show_branch_icon": false,
  },
  "status_bar": {
    "active_language_button": true,
  },
  "project_panel": {
    "hide_root": false,
    "auto_fold_dirs": true,
    "starts_open": true,
    "hide_hidden": false,
    "sticky_scroll": true,
    "git_status": true,
    "folder_icons": true,
    "file_icons": true,
    "hide_gitignore": false,
    "dock": "left",
    "button": true,
  },
  "auto_update": false,
  "format_on_save": "on",
  "terminal": {
    "toolbar": {
      "breadcrumbs": false,
    },
    "font_size": 13.0,
    "button": false,
    "font_family": "Iosevka Nerd Font",
  },
  "toolbar": {
    "breadcrumbs": false,
  },
  "git": {
    "blame": {
      "show_avatar": true,
    },
    "inline_blame": {
      "show_commit_summary": false,
      "enabled": false,
    },
    "git_gutter": "tracked_files",
  },
  "disable_ai": true,
  "vim_mode": false,
  "ui_font_family": "Iosevka Nerd Font",
  "buffer_font_family": "Iosevka Nerd Font",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "icon_theme": {
    "mode": "dark",
    "light": "JetBrains New UI Icons (Dark)",
    "dark": "JetBrains New UI Icons (Dark)",
  },
  "base_keymap": "VSCode",
  "ui_font_size": 17.0,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Tokyo Night",
  },
  "languages": {
    "C": {
      "format_on_save": "on",
      "tab_size": 4,
      "language_servers": ["clangd"],
    },
    "PHP": {
      "format_on_save": "on",
      "tab_size": 4,
      "language_servers": ["phpantom"],
    },
    "Python": {
      "format_on_save": "on",
      "tab_size": 4,
      "language_servers": ["ty", "ruff"],
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
    },
    "HTML": {
      "format_on_save": "on",
      "tab_size": 2,
      "language_servers": ["superhtml"],
      "formatter": "language_server",
    },
  },
  "lsp": {
    "ty": {
      "binary": {
        "path": "/home/ndaru/.local/bin/ty",
        "arguments": ["server"],
      },
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "lineLength": 80,
          "lint": {
            "extendSelect": ["I"],
          },
        },
      },
    },
  },
}
